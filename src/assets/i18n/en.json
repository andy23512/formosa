  "home-page": {
    "website-name": "Formosa",
    "summary": ["A practice tool for", "Bopomofo chords", ""],
    "lesson-start-instruction": [
      "Use ",
      "space",
      " key to enter the first lesson, or select a lesson from the list on the left."
    ],
    "source-code": "source code",
    "remark": "Formosa (pronunciation: /fɔːrˈmoʊzə/) is a red clump giant star in the constellation Leo, about 451 light-years from Earth."
  },
  "information-page": {
    "description": "Formosa is an unofficial practice tool for typing Bopomofo (Zhuyin) chords on the TanChord 36 layout with CharaChorder 3D input devices — CharaChorder One, CharaChorder Two, CCU and Master Forge, as well as the Standard Bopomofo layout with flat keyboards.",
    "about-the-name": {
      "title": "about the name",
      "description": "Formosa (pronunciation: /fɔːrˈmoʊzə/) is a red clump giant star in the constellation Leo, about 451 light-years from Earth. It was named by Taiwan during the IAU's 100th anniversary NameExoWorlds campaign — \"Formosa\" is the historical Portuguese name for Taiwan, meaning \"beautiful\"."
    },
    "page-introductions-title": "page introductions",
    "key-lesson-page": {
      "title": "lesson page",
      "description": [
        "At the lesson page, you practice typing Bopomofo chords — multi-symbol combinations like ㄅㄧㄥ typed as a single chord — on your CharaChorder device. Lessons are grouped by initial consonant (聲母) or medial (介音) in the side menu, plus an All Bopomofo Chords lesson covering every chord.",
        "If you want a goal for your practice, try to reach 100 ChPM (chords per minute) in each lesson."
      ]
    },
    "statistics-page": {
      "title": "statistics page",
      "description": "At the statistics page, you can check your practice statistics, including a graph that shows your typing speed (ChPM) over time."
    },
    "settings-page": {
      "title": "settings page",
      "description": "At the settings page, you can choose your Layout — the device and OS keyboard combination, such as Standard Bopomofo or TanChord 36 V2 — toggle the visibility of layout components, adjust the rotation angle of the layout preview, and switch the UI language."
    },
    "disclaimers": {
      "title": "disclaimers",
      "description": [
        [
          "This site is not affiliated, associated, authorized, endorsed by, or in any way officially connected with CharaChorder. Their official website can be found at ",
          "{{charachorder url}}",
          "."
        ],
        [
          "Your typing statistics and settings in this tool are kept and stored locally in the ",
          "IndexedDB",
          " and ",
          "localStorage",
          " of your browser. They are not transmitted to any other place via this tool."
        ]
      ]
    }
  },
